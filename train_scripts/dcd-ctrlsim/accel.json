{
  "grid": {
    "env_name": ["Nocturne-CtrlSim-v0"],
    "ued_algo": ["domain_randomization"],
    "num_processes": [32],
    "num_env_steps": [32768000],
    "seed": [123],

    "__note1__": ["learning parameters"],
    "lr": [3e-4],
    "gamma": [0.99],
    "use_gae": [true],
    "gae_lambda": [0.95],
    "handle_timelimits": [false],
    "num_steps": [512],
    "ppo_epoch": [10],
    "num_mini_batch": [32],
    "recurrent_agent": [false],
    "recurrent_adversary_env": [false],
    "recurrent_hidden_size": [256],
    "entropy_coef": [0.01],
    "value_loss_coef": [0.5],
    "clip_param": [0.2],
    "clip_value_loss": [false],
    "max_grad_norm": [0.5],
    
    "__note2__": ["PLR parameters"],
    "use_plr": [true],
    "level_replay_prob": [0.75],
    "level_replay_rho": [0.5],
    "level_replay_seed_buffer_size": [8000],
    "level_replay_strategy": ["positive_value_loss"],
    "level_replay_score_transform": ["rank"],
    "level_replay_temperature": [0.3],
    "staleness_coef": [0.5],
    "base_levels": ["easy"],
    "no_exploratory_grad_updates": [true],

    "__note3__": ["ACCEL parameters"],
    "use_editor": [true],
    "level_editor_prob": [1.0],
    "level_editor_method": ["random"],
    "mutation_mode": ["all"],
    "mutation_range": [5.0],


    "__note4__": ["tilting parameters"],
    "tilting_mode": ["per_vehicle"],
    "tilt_range_min": [-25],
    "tilt_range_max": [25],

    "__note5__": ["warmup parameters"],
    "warm_up_level_replay_seed_buffer_size": [10000],
    "warmup_opponent_disable_ratio": [0.0],
    "warmup_opponent_replay_ratio": [0.1],

    "__note6__": ["logging parameters"],
    "verbose": [false],
    "test_env_names": [""],
    "log_plr_buffer_stats": [false],
    "screenshot_interval": [10000],
    "log_interval": [10000],
    "checkpoint_interval": [100],
    "archive_interval": [100],

    "__note7__": ["student reward setup"],
    "use_approaching_goal" : [true],
    "use_persistent_position_reward": [false],
    "use_heading_shaped": [true],
    "use_veh_veh_shaped": [false],
    "use_veh_edge_shaped": [false],
    "veh_veh_collision_rew_multiplier": [10.0],
    "veh_edge_collision_rew_multiplier": [10.0],
    "pos_target_achieved_rew_multiplier": [10.0],
    "approaching_goal_scaling": [1.0],

    "__note8__": ["inference parameters"],
    "sparse_inference_action_repeat": [true],
    "inference_precision": ["amp_bf16"],
    "action_repeat_frequency": [2],

    "__note9__": ["KL loss parameters"],
    "use_ego_ctrlsim_kl_loss": [false],
    "ego_ctrlsim_kl_schedule": ["constant"],
    "kl_loss_coef": [0.2],
    "kl_loss_computation_frequency": [2],
    "ego_ctrlsim_kl_init_coef" : [0.5],
    "ego_ctrlsim_kl_min_coef": [0.0],

    "__note10__": ["dataset parameters"],
    "scenario_index_path": ["preparation_file/scenarios_index_filtered_train.json"],
    "scenario_data_dir": ["scenario_data/formatted_json_v2_no_tl_train"],
    "preprocess_dir": ["compressed_preprocessed_data/train"],
    "opponent_checkpoint": ["checkpoints/model_fp16.ckpt"],
    "vehicle_map_path": ["preparation_file/vehicle_map_filtered_train.json"],
    "log_dir": ["~/logs/dcd"],

    "__note11__": ["clearml"],
    "use_clearml": ["true"],
    "clearml_task": ["dcd-ctrlsim"]
  }
}
